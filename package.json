{
  "name": "surveyjs-market-research-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --port=3004 --host=0.0.0.0 --strictPort",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview --port=3004 --strictPort",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "bootstrap-icons": "^1.13.1",
    "bootswatch": "^5.3.8",
    "express": "^4.21.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "survey-core": "3.2.5",
    "survey-creator-core": "3.2.5",
    "survey-creator-react": "3.2.5",
    "survey-react-ui": "3.2.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
